_GQL_URL = "https://api.7tv.app/v4/gql"
_TWITCH_CATALOG_URL = "https://emotes.crippled.dev/v1"
_TWITCH_GLOBAL = "__twitch_global__"
_ALT = "🙂"
_PACK_TITLE = "SevenTV Emotes"
_VIDEO_MAX_BYTES = 256_000
_VIDEO_TARGET_BYTES = 240_000
_VIDEO_PROFILES = (
    (128000, 30), (64000, 30), (32000, 30), (16000, 24),
    (8000, 20), (4000, 15), (2000, 12),
)
_WORD_RE = re.compile(r"\S+")
_CHANNEL_RE = re.compile(r"^[A-Za-z0-9_]{2,25}$")
_USER_QUERY = """
query($name: String!) {
  users { search(query: $name, perPage: 20) {
    items { connections { platform platformUsername platformAvatarUrl platformDisplayName }
      style { activeEmoteSet { id } activeProfilePicture { images { url scale } } } }
  } }
}
"""
_SET_QUERY = """
query($id: Id!, $page: Int!) {
  emoteSets { emoteSet(id: $id) { emotes(page: $page, perPage: 1000) {
    pageCount totalCount items { alias emote { id images {
      url width height mime frameCount scale
    } } }
  } } }
}
"""


def _java_list(values):
    """Read Java lists without relying on the bridge's Python iterator support."""
    return [values.get(index) for index in range(int(values.size()))]


def _utf16_offsets(text):
    result = [0]
    offset = 0
    for char in text:
        offset += 2 if ord(char) > 0xFFFF else 1
        result.append(offset)
    return result


def _channels(value):
    result = []
    seen = set()
    for raw in re.split(r"[,\s]+", str(value or "")):
        name = raw.strip().removeprefix("https://www.twitch.tv/").strip("/")
        if _CHANNEL_RE.fullmatch(name) and name.lower() not in seen:
            result.append(name.lower())
            seen.add(name.lower())
    return result


def _choose_images(images):
    """Use an actual CDN rendition, never resize it for Telegram upload."""
    pngs = [
        image for image in images
        if image.get("mime") == "image/png"
        and int(image.get("frameCount", 0)) == 1
        and image.get("url")
    ]
    if not pngs:
        return None, None
    usable = [image for image in pngs if 0 < int(image.get("height", 0)) <= 100]
    source = (
        max(usable, key=lambda item: int(item.get("height", 0)))
        if usable else min(pngs, key=lambda item: int(item.get("height", 0)))
    )
    preview = min(pngs, key=lambda item: int(item.get("scale", 99)))
    return source, preview


def _choose_animation(images, source):
    gifs = [
        image for image in images
        if image.get("mime") == "image/gif"
        and int(image.get("frameCount", 0)) > 1
        and image.get("url")
    ]
    if not gifs:
        return None, None
    candidates = [
        image for image in gifs
        if int(image.get("width", 0)) == int(source["width"])
        and int(image.get("height", 0)) == int(source["height"])
    ]
    if not candidates:
        raise ValueError("7TV did not provide a matching GIF rendition")
    return candidates[0], min(gifs, key=lambda item: int(item.get("scale", 99)))


def _tile_origins(width, height, size=100):
    """Return square crop origins. Padding is transparent; pixels are unscaled."""
    if width <= 0 or height <= 0:
        return []
    return [
        (x, y)
        for y in range(0, height, size)
        for x in range(0, width, size)
    ]


def _picker_items(emotes, query, channel=None):
    query = str(query or "").strip().casefold()
    return sorted(
        (emote for emote in emotes.values()
         if (channel is None or emote.channel.casefold() == channel.casefold())
         and (not query or query in emote.code.casefold() or query in emote.channel.casefold()
              or query in emote.provider.casefold())),
        key=lambda emote: (emote.code.casefold(), emote.code),
    )


def _picker_insertion(prefix, suffix, code):
    left = " " if prefix and not prefix[-1].isspace() else ""
    right = " " if not suffix or not suffix[0].isspace() else ""
    return left + code + right


class _Emote:
    __slots__ = (
        "animation_url", "channel", "channel_avatar_url", "channel_display_name", "code", "emote_id",
        "preview_animation_url", "preview_url", "source_url", "provider",
    )

    def __init__(
        self, channel, code, emote_id, source_url, preview_url,
        animation_url=None, preview_animation_url=None,
        channel_avatar_url=None, channel_display_name=None, provider="7TV",
    ):
        self.channel = channel
        self.channel_avatar_url = channel_avatar_url
        self.channel_display_name = channel_display_name or channel
        self.code = code
        self.emote_id = emote_id
        self.source_url = source_url
        self.preview_url = preview_url
        self.animation_url = animation_url
        self.preview_animation_url = preview_animation_url
        self.provider = provider


def _emote_source(emote):
    if emote.channel == _TWITCH_GLOBAL:
        return "Twitch · глобальные"
    return f"{emote.provider} · @{emote.channel}"


def _parse_twitch_emotes(items, channel=None):
    if not isinstance(items, list):
        raise ValueError("Twitch catalogue did not return an emote list")
    emotes = []
    for item in items:
        if not isinstance(item, dict) or item.get("provider") != 0:
            continue
        code = item.get("code")
        if not isinstance(code, str) or not code or any(char.isspace() for char in code):
            continue
        emote_id = None
        for image in item.get("urls") or []:
            if not isinstance(image, dict) or not isinstance(image.get("url"), str):
                continue
            parsed = urlparse(image["url"])
            if parsed.scheme != "https" or parsed.netloc != "static-cdn.jtvnw.net":
                continue
            match = re.fullmatch(
                r"/emoticons/v2/([A-Za-z0-9_-]{1,128})/(?:default|static|animated)/(?:light|dark)/[123]\.0",
                parsed.path,
            )
            if match:
                emote_id = match.group(1)
                break
        if emote_id is None:
            continue
        base = f"https://static-cdn.jtvnw.net/emoticons/v2/{emote_id}"
        animated = item.get("animated") is True
        # The 2x rendition is normally 56px high; 3x is 112px and would
        # unnecessarily split a square Twitch emote into four 100px tiles.
        emotes.append(_Emote(
            channel or _TWITCH_GLOBAL, code, "twitch_" + emote_id,
            base + "/static/dark/2.0", base + "/static/dark/1.0",
            base + "/animated/dark/2.0" if animated else None,
            base + "/animated/dark/1.0" if animated else None,
            channel_display_name=channel or "Twitch", provider="Twitch",
        ))
    if items and not emotes:
        raise ValueError("Twitch catalogue contains no valid Twitch emotes")
    return emotes


class _EnterViewConstructed(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            account = int(param.args[2].getCurrentAccount())
        except Exception:
            account = int(UserConfig.selectedAccount)
        self.plugin._attach_editor(param.thisObject, account)


class _SendHook(MethodHook):
    def __init__(self, plugin, editing=False):
        self.plugin = plugin
        self.editing = editing

    def before_hooked_method(self, param):
        try:
            if self.plugin._defer_send(
                param.thisObject, tuple(param.args), self.editing
            ):
                param.setResult(None if self.editing else False)
        except Exception as exc:
            self.plugin.log(f"7TV: send preparation failed: {exc}")
            param.setResult(None if self.editing else False)
            BulletinHelper.show_error(f"7TV: не удалось подготовить сообщение: {exc}")


class _EntitiesHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            key = int(System.identityHashCode(param.thisObject))
            account = self.plugin._media_accounts.get(key)
            if account is None:
                account = int(param.thisObject.JA.currentAccount)
            box = param.args[0]
            if box is not None and box[0] is not None:
                converted = self.plugin._convert_entities(box[0], account)
                if converted is not None:
                    box[0] = converted
        except Exception as exc:
            self.plugin.log(f"7TV: entity conversion failed: {exc}")


class _EmojiPanelHook(MethodHook):
    def __init__(self, plugin, attach=False, close_search=False):
        self.plugin = plugin
        self.attach = attach
        self.close_search = close_search

    def after_hooked_method(self, param):
        try:
            if self.close_search:
                state = self.plugin._panels.get(int(System.identityHashCode(param.thisObject)))
                if state is not None:
                    self.plugin._close_picker_search(state)
            elif self.attach:
                self.plugin._attach_emoji_panel(param.thisObject)
            else:
                self.plugin._attach_emoji_panel(param.thisObject)
        except Exception as exc:
            self.plugin.log(f"7TV: picker integration failed: {exc}")


class _EnterEmojiPanelHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            enter = param.thisObject
            panel = enter.getEmojiView()
            if panel is not None:
                self.plugin._attach_emoji_panel(panel, enter)
        except Exception as exc:
            self.plugin._picker_notice(f"Не удалось подключить панель: {exc}")


class _EmojiPagerHook(MethodHook):
    def __init__(self, plugin, method):
        self.plugin = plugin
        self.operation = method

    def before_hooked_method(self, param):
        state = self.plugin._panels_by_adapter.get(int(System.identityHashCode(param.thisObject)))
        if state is None:
            return
        if self.operation == "getCount":
            state["count_hook_hits"] = state.get("count_hook_hits", 0) + 1
            owner = state["owner_ref"].get()
            tabs = get_private_field(owner, "currentTabs") if owner is not None else None
            if tabs is not None:
                state["native_count"] = int(tabs.size()) - int(self.plugin._native_picker_tab_present(state, tabs))
            if self.plugin._panel_available(state):
                # setResult takes Object. Plain Python int is boxed as Long;
                # the int-returning Java method requires an actual Integer.
                param.setResult(Integer(4))
            return
        if self.operation == "getItemPosition":
            root = self.plugin._panel_view(state, "root")
            if root is not None and int(System.identityHashCode(param.args[0])) == int(System.identityHashCode(root)):
                param.setResult(Integer(-2))  # PagerAdapter.POSITION_NONE.
            return
        position = int(param.args[1] if self.operation == "instantiateItem" else param.args[0])
        if position != 3 or not self.plugin._panel_available(state):
            return
        if self.operation == "getPageTitle":
            param.setResult("7TV")
        elif self.operation == "getPageIconDrawable":
            param.setResult(None)  # Use the tab's text label.
        elif self.operation == "canScrollToTab":
            owner = state["owner_ref"].get()
            param.setResult(not bool(get_private_field(owner, "emojiBanned")))
        elif self.operation == "instantiateItem":
            root = self.plugin._ensure_picker_page(state)
            parent = param.args[0]
            old_parent = root.getParent()
            if old_parent is not None and int(System.identityHashCode(old_parent)) != int(System.identityHashCode(parent)):
                old_parent.removeView(root)
            if root.getParent() is None:
                parent.addView(root)
            param.setResult(root)


@java_subclass(BaseAdapter)
class _PickerAdapter(Base):
    def __init__(self, plugin, state):
        self.plugin = plugin
        self.state = state

    @joverride()
    def getCount(self):
        return len(self.state["items"]) if self.plugin._alive else 0

    @joverride()
    def getItem(self, position):
        return self.state["items"][int(position)].code

    @joverride()
    def getItemId(self, position):
        return int(position)

    @joverride()
    def getView(self, position, recycled, parent):
        return self.plugin._picker_cell(self.state, int(position), recycled, parent)


class _PickerClick(dynamic_proxy(jclass("android.widget.AdapterView$OnItemClickListener"))):
    def __init__(self, plugin, state):
        super().__init__()
        self.plugin = plugin
        self.state = state

    def onItemClick(self, parent, view, position, item_id):
        self.plugin._pick_emote(self.state, int(position))


class _PickerChannelClick(dynamic_proxy(jclass("android.view.View$OnClickListener"))):
